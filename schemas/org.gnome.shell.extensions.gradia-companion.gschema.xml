<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gradia-companion" path="/org/gnome/shell/extensions/gradia-companion/">
    <key name="tool-settings" type="a{s(sd)}">
      <default>{'freehand': ('#000000', 3.0), 'rectangle': ('#000000', 3.0), 'solid-rectangle': ('#000000', 3.0), 'highlighter': ('#ffdd00', 4.0), 'arrow': ('#000000', 3.0), 'stamp': ('#000000', 3.0)}</default>
      <summary>Per-tool color and line width</summary>
    </key>
    <key name="screenshot-format" type="s">
      <default>'png'</default>
      <summary>File format for saved screenshots</summary>
    </key>
    <key name="play-sound" type="b">
      <default>true</default>
      <summary>Play sound when a screenshot is taken</summary>
    </key>
    <key name="composite-window-capture" type="b">
      <default>true</default>
      <summary>Composite transient windows when capturing a window screenshot</summary>
    </key>
    <key name="language" type="s">
      <default>'system'</default>
      <summary>Interface language override</summary>
      <description>Force the extension interface into a specific language. Set to 'system' to follow the system locale, or use a language code such as 'zh_CN' or 'en'.</description>
    </key>
  </schema>
</schemalist>
